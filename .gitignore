
# --- ENTORNOS VIRTUALES ---
# Ignora las librerías instaladas en tu compu
venv/
ENV/
env/

# --- ARCHIVOS TEMPORALES DE PYTHON ---
# Ignora las carpetas que crea Python automáticamente al correr código
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- CONFIGURACIONES DE VS CODE ---
# Ignora los ajustes locales de tu editor de texto
.vscode/

# --- CONFIGURACIONES DEL SISTEMA OPERATIVO ---
# Ignora archivos invisibles de Windows/Mac (como miniaturas)
Thumbs.db
.DS_Store

# --- ARCHIVOS DE DATOS / CREDENCIALES ---
.env
*.log
# Secretos y credenciales de Streamlit
.streamlit/secrets.toml

# --- ARCHIVOS TEMPORALES DE INDEXAL ---
# Ignora las imágenes subidas localmente y los PDFs temporales de exportación
data/imagenes_analizadas/*
!data/imagenes_analizadas/.gitkeep
assets/reporte_temp*.pdf
assets/temp_*.pdf

# Salidas generadas automáticamente (heatmaps y reportes temporales)
output/
data/imagenes_analizadas/*
!data/imagenes_analizadas/.gitkeep